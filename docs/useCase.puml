@startuml UseCaseDiagram
left to right direction
skinparam packageStyle rectangle
skinparam actorStyle awesome

actor Admin
actor Vente
actor Stock
actor Inventaire

Admin --|> Vente
Admin --|> Stock
Admin --|> Inventaire

rectangle "StoreManager Pro" {

  package "Tableau de Bord (Admin uniquement)" {
    usecase "Consulter le Tableau de Bord" as UC1
  }

  package "Module Ventes (POS)" {
    usecase "Encaisser une vente (POS)" as UC2
    usecase "Selectionner un client existant" as UC3
  }

  package "Module Dettes" {
    usecase "Consulter le registre des dettes" as UC4
    usecase "Enregistrer un remboursement de dette" as UC5
    usecase "Mettre a jour le statut de la dette" as UC5a
  }

  package "Module Approvisionnements" {
    usecase "Creer un bon de livraison" as UC6
    usecase "Receptionner un bon de livraison" as UC7
    usecase "Incrementer le stock" as UC7a
  }

  package "Module Catalogue (Produits / Clients / Fournisseurs)" {
    usecase "Gerer les produits " as UC8
    usecase "Gerer les clients " as UC9
    usecase "Gerer les fournisseurs " as UC10
  }
}

Admin --> UC1

Vente --> UC2
Vente --> UC3
Vente --> UC4
Vente --> UC5

Stock --> UC6
Stock --> UC7
Stock --> UC8
Stock --> UC9
Stock --> UC10

Inventaire --> UC8
Inventaire --> UC9
Inventaire --> UC10

UC2 ..> UC3 : <<include>>
UC5 ..> UC5a : <<include>>
UC7 ..> UC7a : <<include>>

@enduml